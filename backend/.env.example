# Project Core Config
PROJECT_NAME="AgriVision AI"
API_V1_STR="/api/v1"

# Backend URL - REQUIRED for image serving on production
# Local development: http://localhost:8000
# Production (Azure App Service): https://agrivision-backend.azurewebsites.net
BACKEND_URL="http://localhost:8000"

# Database Configuration (Supabase PostgreSQL)
# Format 1 (Direct): postgresql+asyncpg://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
# Format 2 (Pooler): postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Connection Pooling Settings (Optional overrides)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Authentication
SUPABASE_JWT_SECRET="agrivision-secure-jwt-secret-change-in-production-2024"
SUPABASE_JWT_ALGORITHM="HS256"

# Cloudflare R2 / S3 Storage (optional - uses local storage if empty)
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_ENDPOINT_URL=""
R2_BUCKET_NAME=""

# Modal ML Inference Serverless Endpoint (optional - uses local model if empty)
MODAL_API_URL=""
CONFIDENCE_THRESHOLD=0.60

# AI Assistant / Chatbot (AgriBot)
# AI_PROVIDER = "openai" or "gemini"
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-3.6-flash"

